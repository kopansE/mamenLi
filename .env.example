# Square Inch - copy to .env and fill in. Never commit .env.
# Stripe keys: https://dashboard.stripe.com/apikeys

# Server-side only. Never sent to the browser.
STRIPE_SECRET_KEY=

# Safe to expose to the browser.
STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# Commission taken on each placement, in percent.
PLATFORM_FEE_PERCENT=8

# ISO currency code.
CURRENCY=usd

PORT=8787

# Used to build Stripe return URLs. Leave blank to infer from the request.
PUBLIC_BASE_URL=

# --- Supabase (real users, live bidding, live chat) -------------------------
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then paste the Project URL and the anon/public key here.
# The anon key is safe in the browser - Row Level Security is what protects data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS - never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
