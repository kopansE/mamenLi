# Square Inch - copy to .env and fill in. Never commit .env.
#
# Everything here is optional. With the file blank the site still runs: the
# front end falls back to a demo market held in the browser's own storage.

# --- Stripe ----------------------------------------------------------------
# https://dashboard.stripe.com/apikeys

# Server-side only. Never sent to the browser.
STRIPE_SECRET_KEY=

# Safe to expose to the browser.
STRIPE_PUBLISHABLE_KEY=

# From `stripe listen --forward-to localhost:8787/api/webhook`, or from the
# Dashboard endpoint. Without it the webhook refuses every request, which
# means authorised bids are never recorded - so set it before taking money.
STRIPE_WEBHOOK_SECRET=

# Commission taken on each settled spot, in percent.
PLATFORM_FEE_PERCENT=8

# ISO currency code.
CURRENCY=usd

# --- Supabase --------------------------------------------------------------
# Create a project at https://supabase.com, run supabase/schema.sql in the SQL
# editor, then paste the Project URL and the anon/public key here.
# The anon key is MEANT to be in the browser - Row Level Security is the
# protection, which is why the schema ships with policies rather than TODOs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. This one bypasses RLS entirely: it is what lets the server
# write the bids table that the browser is forbidden to touch. If this leaks,
# your database is wide open. Never put it in a client bundle, a public env
# var, or anything prefixed NEXT_PUBLIC_/VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres password for this project (Project Settings -> Database).
# Used only by the Supabase CLI to push migrations - the app never reads it.
# Not viewable in the dashboard after creation; reset it there if it is lost.
SUPABASE_DB_PASSWORD=

# --- Email (Resend) --------------------------------------------------------
# NOTE: the app does not read this. Supabase sends the auth emails, and it
# needs the key entered in its own dashboard under
# Project Settings -> Authentication -> SMTP Settings. It is kept here so the
# credential lives with the others, and for when the server starts sending its
# own mail ("you have been outbid"), which is the point of having SMTP at all.
#   Host smtp.resend.com  Port 465  Username resend  Password <this key>
RESEND_API_KEY=
RESEND_FROM=no-reply@mimonim.com

# --- This server -----------------------------------------------------------
PORT=8787

# Used to build the URLs Stripe returns to. Leave blank to infer from the
# request; set it in production so a spoofed Host header cannot redirect
# your buyers somewhere else.
PUBLIC_BASE_URL=

# How many reverse proxies sit in front of this server.
#   (blank/0) nothing in front - trust the socket address
#   1         one proxy (Vercel, Fly, Render, Railway, a single nginx)
#   2         a CDN AND a load balancer
# This MUST match reality. Setting it higher than the truth lets a caller
# spoof X-Forwarded-For and pick their own rate-limit bucket, which makes
# every limit below meaningless.
TRUST_PROXY=

# Set to `production` on a real deployment. Turns on HSTS and marks cookies
# Secure, both of which would break plain-HTTP local development.
NODE_ENV=development

# Shared secret for POST /api/settle/:listingId, the job that captures the
# winners and releases everyone else when a listing closes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTLE_SECRET=
